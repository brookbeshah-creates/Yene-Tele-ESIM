# ==============================================================================
# YENE TELE (የእኔ ቴሌኮም) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local or production runtime. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME ENVIRONMENT & SERVER
# ------------------------------------------------------------------------------
# YENE_ENV_MODE: local_dev | demo | sandbox | production
# - local_dev / sandbox / demo: allows in-memory fallback store if DATABASE_URL is unset
# - production: FAILS CLOSED on startup unless DATABASE_URL, persistent ESIM_ENCRYPTION_KEY,
#   CHAPA_SECRET_KEY, CHAPA_WEBHOOK_SECRET, YENE_ADMIN_EMAILS, and ALLOWED_ORIGINS are valid.
YENE_ENV_MODE=sandbox
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_URL="http://localhost:3000"
# Mandatory in production: comma-separated exact browser origins (e.g. https://yenetele.et)
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. POSTGRESQL PERSISTENCE (Required for staging/production)
# ------------------------------------------------------------------------------
# Standard PostgreSQL connection string (managed Postgres, RDS, Neon, Supabase, or self-hosted)
DATABASE_URL=
# Set to true when connecting to TLS-enforced managed PostgreSQL providers
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & STAFF RBAC
# ------------------------------------------------------------------------------
# Comma-separated verified staff email addresses granted initial Super Admin access
YENE_ADMIN_EMAILS=
# Optional path to Firebase Admin service account JSON if running outside Google Cloud ADC
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# 4. ENCRYPTION & CRYPTOGRAPHIC SECURITY (Required in production)
# ------------------------------------------------------------------------------
# 64-character hex string (32 bytes) for AES-256-GCM eSIM QR / SM-DP+ vault encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESIM_ENCRYPTION_KEY=
# Shared HMAC secret for signed inbound telecom operator provisioning callbacks (when live)
OPERATOR_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. CHAPA PAYMENT GATEWAY & EXPIRY SCHEDULER
# ------------------------------------------------------------------------------
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_CALLBACK_URL=
# Background payment timeout sweep settings
PAYMENT_EXPIRY_INTERVAL_MS=60000
PAYMENT_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------------------
# 6. EXTERNAL PARTNER INTEGRATIONS (Leave blank until partner contracts live)
# ------------------------------------------------------------------------------
ETHIO_TELECOM_API_URL=
ETHIO_TELECOM_API_KEY=
SAFARICOM_API_URL=
SAFARICOM_API_KEY=
FAYDA_RELYING_PARTY_ID=
FAYDA_AUTH_URL=
KLICK_API_URL=
KLICK_API_KEY=

# ------------------------------------------------------------------------------
# 7. RUNTIME PLATFORM OPTIONAL KEY
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
