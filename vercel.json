{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{firebase-applet-config.json,server/db/migrations/*.sql}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__vercel_path=$1"
    },
    {
      "source": "/((?!api(?:/|$)|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
